{
  "name": "ffshift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FFShift —— ffmpeg 的换挡键：不用懂参数，也能转好视频",
  "scripts": {
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:verify": "node scripts/verify-hooks.mjs",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:digest": "node scripts/docs-digest.mjs",
    "lint:commit": "node scripts/lint-commit.mjs",
    "test": "vitest run",
    "test:unit": "vitest run src/",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
